{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 27, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/cmake-build-${presetName}",
      "cacheVariables": {
        "OPENDIGITIZER_ENABLE_TESTING": "ON"
      }
    },
    {
      "name": "gcc-debug",
      "inherits": "base",
      "displayName": "GCC Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "gcc-release",
      "inherits": "base",
      "displayName": "GCC Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "clang-debug",
      "inherits": "base",
      "displayName": "Clang Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "clang-release",
      "inherits": "base",
      "displayName": "Clang Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "wasm-release",
      "inherits": "base",
      "displayName": "WASM Release (dynload plugins)",
      "description": "Load SIDE_MODULE *Plugin.wasm at runtime; expects GR4 from ci-latest-wasm (/opt/gnuradio4-emscripten)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "/opt/emsdk/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
        "DISABLE_WASM_BUILD": "ON",
        "OPENDIGITIZER_ENABLE_TESTING": "OFF",
        "CMAKE_FIND_ROOT_PATH_MODE_PACKAGE": "BOTH",
        "CMAKE_PREFIX_PATH": "/opt/gnuradio4-emscripten",
        "OD_WASM_STATIC_BLOCKLIBS": "OFF"
      }
    },
    {
      "name": "wasm-static-blocklibs",
      "inherits": "base",
      "displayName": "WASM Release (static blocklibs)",
      "description": "Link Gr*Blocks into the main module; expects GR4 from ci-latest-wasm-static (/opt/gnuradio4-emscripten-static)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "/opt/emsdk/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
        "DISABLE_WASM_BUILD": "ON",
        "OPENDIGITIZER_ENABLE_TESTING": "OFF",
        "CMAKE_FIND_ROOT_PATH_MODE_PACKAGE": "BOTH",
        "CMAKE_PREFIX_PATH": "/opt/gnuradio4-emscripten-static",
        "OD_WASM_STATIC_BLOCKLIBS": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "gcc-debug", "configurePreset": "gcc-debug", "jobs": 6 },
    { "name": "gcc-release", "configurePreset": "gcc-release", "jobs": 6 },
    { "name": "clang-debug", "configurePreset": "clang-debug", "jobs": 6 },
    { "name": "clang-release", "configurePreset": "clang-release", "jobs": 6 },
    { "name": "wasm-release", "configurePreset": "wasm-release", "jobs": 6 },
    { "name": "wasm-static-blocklibs", "configurePreset": "wasm-static-blocklibs", "jobs": 6 }
  ]
}
