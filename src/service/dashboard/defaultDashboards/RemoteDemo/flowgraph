dashboard:
  layout: Free
  sources:
    - name: PlotSine20k
      block: PlotSine20k
    - name: PlotSquare20k
      block: PlotSquare20k
    - name: PlotSaw10k
      block: PlotSaw10k
    - name: PlotTriangle10k
      block: PlotTriangle10k
    - name: PlotSine20kDataSet
      block: PlotSine20kDataSet
    - name: PlotSquare20kDataSet
      block: PlotSquare20kDataSet
    - name: PlotSaw10kDataSet
      block: PlotSaw10kDataSet
    - name: PlotTriangle10kDataSet
      block: PlotTriangle10kDataSet
    - name: PlotSine20kTriggered
      block: PlotSine20kTriggered
    - name: PlotSquare20kTriggered
      block: PlotSquare20kTriggered
    - name: PlotSaw10kTriggered
      block: PlotSaw10kTriggered
    - name: PlotTriangle10kTriggered
      block: PlotTriangle10kTriggered
    - name: PlotSine20kTriggered16k
      block: PlotSine20kTriggered16k
    - name: PlotSine20kMultiplexed
      block: PlotSine20kMultiplexed
    - name: PlotSquare20kMultiplexed
      block: PlotSquare20kMultiplexed
    - name: PlotSine20kSnapshot
      block: PlotSine20kSnapshot
    - name: PlotTone10kFFT
      block: PlotTone10kFFT
    - name: PlotTagContext
      block: PlotTagContext
  plots:
    - name: StreamsAt20k
      parameters:
        n_history: 200000 # 10 s at 20 kHz
        show_tags: true
        show_legend: true
      axes:
        - axis: X
          min: inf
          max: inf
          scale: Time
        - axis: Y
          min: inf
          max: inf
      sources:
        - PlotSine20k
        - PlotSquare20k
      rect: [0, 0, 1, 1]
    - name: StreamsAt10k
      parameters:
        n_history: 100000 # 10 s at 10 kHz
        show_tags: true
        show_legend: true
      axes:
        - axis: X
          min: inf
          max: inf
          scale: Time
        - axis: Y
          min: inf
          max: inf
      sources:
        - PlotSaw10k
        - PlotTriangle10k
      rect: [1, 0, 1, 1]
    - name: ServiceDataSets
      parameters:
        max_history_count: 1
        show_tags: true
        show_legend: true
      axes:
        - axis: X
          min: inf
          max: inf
          scale: Linear
        - axis: Y
          min: inf
          max: inf
      sources:
        - PlotSine20kDataSet
        - PlotSquare20kDataSet
        - PlotSaw10kDataSet
        - PlotTriangle10kDataSet
      rect: [0, 2, 1, 1]
    - name: TriggeredCaptures
      parameters:
        max_history_count: 1
        show_tags: true
        show_legend: true
      axes:
        - axis: X
          min: inf
          max: inf
          scale: Linear
        - axis: Y
          min: inf
          max: inf
      sources:
        - PlotSine20kTriggered
        - PlotSquare20kTriggered
        - PlotSaw10kTriggered
        - PlotTriangle10kTriggered
      rect: [1, 2, 1, 1]
    - name: Sine20kModes
      parameters:
        max_history_count: 1
        show_tags: true
        show_legend: true
      axes:
        - axis: X
          min: inf
          max: inf
          scale: Linear
        - axis: Y
          min: inf
          max: inf
      sources:
        - PlotSine20kTriggered16k
        - PlotSine20kMultiplexed
        - PlotSquare20kMultiplexed
        - PlotSine20kSnapshot
      rect: [0, 3, 2, 1]
    - name: Tone10kSpectrum
      parameters:
        max_history_count: 1
        show_tags: true
        show_legend: true
      axes:
        - axis: X
          min: inf
          max: inf
          scale: Linear
        - axis: Y
          min: inf
          max: inf
      sources:
        - PlotTone10kFFT
      rect: [0, 1, 1, 1]
    - name: TagToSample
      parameters:
        n_history: 100000 # 10 s at 10 kHz
        show_tags: true
        show_legend: true
      axes:
        - axis: X
          min: inf
          max: inf
          scale: Time
        - axis: Y
          min: inf
          max: inf
      sources:
        - PlotTagContext
      rect: [1, 1, 1, 1]
