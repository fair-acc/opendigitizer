diff --git a/implot.cpp b/implot.cpp
index b63a579..dfeb782 100644
--- a/implot.cpp
+++ b/implot.cpp
@@ -1774,6 +1774,35 @@ void PadAndDatumAxesY(ImPlotPlot& plot, float& pad_L, float& pad_R, ImPlotAlignm
     }
 }
 
+static bool HideNextAxisText(ImPlotPlot& plot, int first_axis, int axis_count) {
+    for (int i = first_axis; i < first_axis + axis_count; ++i) {
+        ImPlotAxis& axis = plot.Axes[i];
+        if (axis.Enabled && axis.HasLabel()) {
+            axis.LabelHiddenToFit = true;
+            return true;
+        }
+    }
+    for (int i = first_axis; i < first_axis + axis_count; ++i) {
+        ImPlotAxis& axis = plot.Axes[i];
+        if (axis.Enabled && axis.HasTickLabels()) {
+            axis.TickLabelsHiddenToFit = true;
+            return true;
+        }
+    }
+    return false;
+}
+
+static void HideAxisTextUntilPlotFits(ImPlotPlot& plot, int first_axis, int axis_count, float canvas_extent, float pad_A, float pad_B,
+                                      void (*pad_and_datum_axes)(ImPlotPlot&, float&, float&, ImPlotAlignmentData*)) {
+    for (;;) {
+        float measured_pad_A = pad_A;
+        float measured_pad_B = pad_B;
+        pad_and_datum_axes(plot, measured_pad_A, measured_pad_B, nullptr);
+        if (canvas_extent - measured_pad_A - measured_pad_B > 0 || !HideNextAxisText(plot, first_axis, axis_count))
+            return;
+    }
+}
+
 //-----------------------------------------------------------------------------
 // RENDERING
 //-----------------------------------------------------------------------------
