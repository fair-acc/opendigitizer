      fft_size: 4096
      sample_rate: 48000
      output_in_db: true
      signal_name: "audio0 spectrum"
  - id: opendigitizer::ImPlotSink<gr::DataSet<float32>>
    parameters:
      name: spectrum
      dataset_index: 0
      signal_name: "audio0 spectrum"
      abscissa_quantity: frequency
      abscissa_unit: Hz
      signal_quantity: magnitude
      signal_unit: dB
  - id: DigitizerUi::ImControlChoice
    parameters:
      name: array
      label: array
      value: square
      choices: ["stereo", "line", "line 0.3 m", "square", "tetrahedron", "UMA16"]
      choice_values:
        stereo:
          "simulatedMicrophones,locator,correlator,continuousLocator,chart:element_positions": !!float64 [[-0.15, 0.0, 0.0], [0.15, 0.0, 0.0]]
          "locator,correlator,continuousLocator,arrivals,chart:receiver_names": ["audio0", "audio1"]
          "locator,correlator,continuousLocator,chart:roi": [-2.0, 2.0, 0.0, 3.0]
          "locator,correlator,continuousLocator,chart:pairs": sequential
          "locator,correlator,continuousLocator,chart:pair_list": !!uint32 [0, 1]
          "window:n_pre": !!uint32 290
          "window:n_post": !!uint32 290
          "correlation,delays,continuousCorrelation,continuousDelays:max_lag": !!uint32 50
          "chart:show_receiver_names": true
          "continuousArrivals:receiver_names": ["audio0", "audio1"]
          "simulatedMicrophones:source_position": [0.5, 1.0, 0.0]
          "simulatedMicrophones:orbit_radius": 0.4
          "simulatedMicrophones:orbit_period": 20
          "display,filtered:map_in": !!uint32 [0, 1, 0, 1]
          "display,filtered:map_out": !!uint32 [0, 1, 2, 3]
          "snapshot0,snapshot1,snapshot2,snapshot3:filter": audio0
          "fft,spectrum:signal_name": "audio0 spectrum"
          "onset0:trigger_name": audio0
          "signal0:signal_name": audio0
          "snapshotSink0:signal_name": "audio0, triggered"
          "signal0,snapshotSink0:visible": true
          "onset1:trigger_name": audio1
          "signal1:signal_name": audio1
          "snapshotSink1:signal_name": "audio1, triggered"
          "signal1,snapshotSink1:visible": true
          "onset2:trigger_name": unused2
          "signal2:signal_name": unused2
          "snapshotSink2:signal_name": unused2
          "signal2,snapshotSink2:visible": false
          "onset3:trigger_name": unused3
          "signal3:signal_name": unused3
          "snapshotSink3:signal_name": unused3
          "signal3,snapshotSink3:visible": false
        line:
          "simulatedMicrophones,locator,correlator,continuousLocator,chart:element_positions": !!float64 [[-4.5, 0.0, 0.0], [-1.5, 0.0, 0.0], [1.5, 0.0, 0.0], [4.5, 0.0, 0.0]]
          "locator,correlator,continuousLocator,arrivals,chart:receiver_names": ["audio0", "audio1", "audio2", "audio3"]
          "locator,correlator,continuousLocator,chart:roi": [-8.0, 8.0, 0.0, 8.0]
          "locator,correlator,continuousLocator,chart:pairs": sequential
          "locator,correlator,continuousLocator,chart:pair_list": !!uint32 [0, 1]
          "window:n_pre": !!uint32 1508
          "window:n_post": !!uint32 1508
          "correlation,delays,continuousCorrelation,continuousDelays:max_lag": !!uint32 1268
          "chart:show_receiver_names": true
          "continuousArrivals:receiver_names": ["audio0", "audio1", "audio2", "audio3"]
          "simulatedMicrophones:source_position": [1.0, 4.0, 0.0]
          "simulatedMicrophones:orbit_radius": 2.5
          "simulatedMicrophones:orbit_period": 25
          "display,filtered:map_in": !!uint32 [0, 1, 2, 3]
          "display,filtered:map_out": !!uint32 [0, 1, 2, 3]
          "snapshot0,snapshot1,snapshot2,snapshot3:filter": audio0
          "fft,spectrum:signal_name": "audio0 spectrum"
          "onset0:trigger_name": audio0
          "signal0:signal_name": audio0
          "snapshotSink0:signal_name": "audio0, triggered"
          "signal0,snapshotSink0:visible": true
          "onset1:trigger_name": audio1
          "signal1:signal_name": audio1
          "snapshotSink1:signal_name": "audio1, triggered"
          "signal1,snapshotSink1:visible": true
          "onset2:trigger_name": audio2
          "signal2:signal_name": audio2
          "snapshotSink2:signal_name": "audio2, triggered"
          "signal2,snapshotSink2:visible": true
          "onset3:trigger_name": audio3
          "signal3:signal_name": audio3
          "snapshotSink3:signal_name": "audio3, triggered"
