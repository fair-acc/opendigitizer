blocks:
  - id: gr::basic::ClockSource
    parameters:
      name: clock
      sample_rate: 48000
      chunk_size: 1024
      n_samples_max: 0
  - id: opendigitizer::localisation::PointSourceAudio
    parameters:
      name: simulatedMicrophones
      n_outputs: 16
      element_positions: !!float64 [[-0.6, -0.6, 0.0], [0.6, -0.6, 0.0], [-0.6, 0.6, 0.0], [0.6, 0.6, 0.0]]
      source_position: [0.3, 0.2, 0.0]
      orbit_radius: 0.6
      orbit_period: 20
      period: 0.5
      sample_rate: 48000
      noise: 0.02
  - id: gr::basic::Selector<float32>
    parameters:
      name: display
      n_inputs: 16
      n_outputs: 4
      map_in: !!uint32 [0, 1, 2, 3]
      map_out: !!uint32 [0, 1, 2, 3]
      back_pressure: false
  - id: gr::basic::Selector<float32>
    parameters:
      name: filtered
      n_inputs: 16
      n_outputs: 4
      map_in: !!uint32 [0, 1, 2, 3]
      map_out: !!uint32 [0, 1, 2, 3]
      back_pressure: false
  - id: gr::filter::BasicFilter<float32>
    parameters:
      name: highpass0
      filter_type: IIR
      filter_response: HIGHPASS
      iir_design_method: BUTTERWORTH
      filter_order: 2
      f_high: 200
      sample_rate: 48000
  - id: gr::blocks::trigger::LevelTrigger<float32, gr::blocks::trigger::ValueCondition::level>
    parameters:
      name: trigger0
      trigger_name: "audio0"
      threshold: 0.2
      hysteresis: 0.1
      edge: rising
  - id: gr::blocks::trigger::Throttle<float32, false>
    parameters:
      name: throttle0
      n_samples: 9600
  - id: gr::filter::BasicFilter<float32>
    parameters:
      name: highpass1
