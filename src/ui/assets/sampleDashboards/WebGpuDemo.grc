blocks:
  # a complex 125 kHz tone at 1 MS/s, as from an SDR front end
  - id: gr::basic::SignalGenerator<complex<float32>>
    parameters:
      name: toneSource
      signal_type: Sin
      frequency: 125000
      amplitude: 1
      sample_rate: 1000000
      chunk_size: 8192
  # the FFT's device path takes complex<float32>: on 'gpu' it runs on the browser's WebGPU adapter in a WebGPU build
  # (gpu:webgpu, or gpu:swift on SwiftShader), and on the CPU elsewhere, with one warning
  - id: gr::blocks::fft::FFT<complex<float32>, gr::DataSet<float32>>
    parameters:
      name: gpuFFT
      fft_size: 8192
      sample_rate: 1000000
      window: Hann
      output_in_db: true
      compute_domain: gpu
  - id: opendigitizer::ImPlotSink<gr::DataSet<float32>>
    parameters:
      name: spectrumSink
      dataset_index: 0
      signal_name: GPU spectrum
      abscissa_quantity: frequency
      abscissa_unit: Hz
      signal_quantity: magnitude
      signal_unit: dB
connections:
  - [toneSource, 0, gpuFFT, 0]
  - [gpuFFT, 0, spectrumSink, 0]
dashboard:
  layout: Grid
  sources:
    - name: spectrumSink
      block: spectrumSink
  plots:
    - name: Spectrum computed on the GPU
      type: opendigitizer::charts::SpectrumView
      parameters:
        n_history: 256
        colormap: ImPlotColormap_Viridis
        top_pane_ratio: 0.4
      sources:
        - spectrumSink
