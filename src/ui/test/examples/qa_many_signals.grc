blocks:
  - id: gr::basic::ClockSource
    parameters:
      name: ClockSource1
      do_zero_order_hold: true
      n_samples_max: 2048
      sample_rate: 4096
      verbose_console: false
  - id: gr::basic::SignalGenerator<float32>
    parameters:
      name: SignalGenerator1
      frequency: 1
      amplitude: 5
      sample_rate: 4096
      signal_type: Sin
  - id: opendigitizer::ImPlotSink<float32>
    parameters:
      name: PlotSink1
      signal_name: Dipole current
      color: 0xE6194B
  - id: opendigitizer::ImPlotSink<float32>
    parameters:
      name: PlotSink2
      signal_name: Quadrupole QD1 current
      color: 0x3CB44B
  - id: opendigitizer::ImPlotSink<float32>
    parameters:
      name: PlotSink3
      signal_name: Quadrupole QF1 current
      color: 0xFFE119
  - id: opendigitizer::ImPlotSink<float32>
    parameters:
      name: PlotSink4
      signal_name: Beam intensity
      color: 0x4363D8
  - id: opendigitizer::ImPlotSink<float32>
    parameters:
      name: PlotSink5
      signal_name: Beam position horizontal
      color: 0xF58231
  - id: opendigitizer::ImPlotSink<float32>
    parameters:
      name: PlotSink6
      signal_name: Beam position vertical
      color: 0x911EB4
  - id: opendigitizer::ImPlotSink<float32>
    parameters:
      name: PlotSink7
      signal_name: RF voltage
      color: 0x46F0F0
  - id: opendigitizer::ImPlotSink<float32>
    parameters:
      name: PlotSink8
      signal_name: RF phase
      color: 0xF032E6
  - id: opendigitizer::ImPlotSink<float32>
    parameters:
      name: PlotSink9
      signal_name: Vacuum pressure sector 1
      color: 0xBCF60C
  - id: opendigitizer::ImPlotSink<float32>
    parameters:
      name: PlotSink10
      signal_name: Vacuum pressure sector 2
      color: 0xFABEBE
  - id: opendigitizer::ImPlotSink<float32>
    parameters:
      name: PlotSink11
      signal_name: Kicker voltage
      color: 0xE6194B
  - id: opendigitizer::ImPlotSink<float32>
    parameters:
      name: PlotSink12
      signal_name: Septum current
      color: 0x3CB44B
  - id: opendigitizer::ImPlotSink<float32>
    parameters:
      name: PlotSink13
      signal_name: Extraction trigger
      color: 0xFFE119
  - id: opendigitizer::ImPlotSink<float32>
    parameters:
      name: PlotSink14
      signal_name: Injection trigger
      color: 0x4363D8
  - id: opendigitizer::ImPlotSink<float32>
    parameters:
      name: PlotSink15
      signal_name: Sextupole S1
      color: 0xF58231
  - id: opendigitizer::ImPlotSink<float32>
    parameters:
      name: PlotSink16
      signal_name: Sextupole S2
      color: 0x911EB4
  - id: opendigitizer::ImPlotSink<float32>
    parameters:
      name: PlotSink17
      signal_name: Steerer H1
      color: 0x46F0F0
  - id: opendigitizer::ImPlotSink<float32>
    parameters:
      name: PlotSink18
      signal_name: Steerer V1
      color: 0xF032E6
  - id: opendigitizer::ImPlotSink<float32>
    parameters:
      name: PlotSink19
      signal_name: Bunch length
      color: 0xBCF60C
  - id: opendigitizer::ImPlotSink<float32>
    parameters:
      name: PlotSink20
      signal_name: Tune horizontal
      color: 0xFABEBE
  - id: opendigitizer::ImPlotSink<float32>
    parameters:
      name: PlotSink21
      signal_name: Tune vertical
      color: 0xE6194B
  - id: opendigitizer::ImPlotSink<float32>
    parameters:
      name: PlotSink22
      signal_name: Chromaticity
      color: 0x3CB44B
  - id: opendigitizer::ImPlotSink<float32>
    parameters:
      name: PlotSink23
      signal_name: Temperature magnet 1
      color: 0xFFE119
  - id: opendigitizer::ImPlotSink<float32>
    parameters:
      name: PlotSink24
      signal_name: Temperature magnet 2
      color: 0x4363D8
  - id: opendigitizer::ImPlotSink<float32>
    parameters:
      name: PlotSink25
      signal_name: Cooling water flow
      color: 0xF58231
  - id: opendigitizer::ImPlotSink<float32>
    parameters:
      name: PlotSink26
      signal_name: Power converter status
      color: 0x911EB4
  - id: opendigitizer::ImPlotSink<float32>
    parameters:
      name: PlotSink27
      signal_name: Spill intensity
      color: 0x46F0F0
  - id: opendigitizer::ImPlotSink<float32>
    parameters:
      name: PlotSink28
      signal_name: Spill quality factor
      color: 0xF032E6
  - id: opendigitizer::ImPlotSink<float32>
    parameters:
      name: PlotSink29
      signal_name: Ion source current
      color: 0xBCF60C
  - id: opendigitizer::ImPlotSink<float32>
    parameters:
      name: PlotSink30
      signal_name: Beam loss monitor 1
      color: 0xFABEBE
connections:
  - [ClockSource1, 0, SignalGenerator1, 0]
  - [SignalGenerator1, 0, PlotSink1, 0]
  - [SignalGenerator1, 0, PlotSink2, 0]
  - [SignalGenerator1, 0, PlotSink3, 0]
  - [SignalGenerator1, 0, PlotSink4, 0]
  - [SignalGenerator1, 0, PlotSink5, 0]
  - [SignalGenerator1, 0, PlotSink6, 0]
  - [SignalGenerator1, 0, PlotSink7, 0]
  - [SignalGenerator1, 0, PlotSink8, 0]
  - [SignalGenerator1, 0, PlotSink9, 0]
  - [SignalGenerator1, 0, PlotSink10, 0]
  - [SignalGenerator1, 0, PlotSink11, 0]
  - [SignalGenerator1, 0, PlotSink12, 0]
  - [SignalGenerator1, 0, PlotSink13, 0]
  - [SignalGenerator1, 0, PlotSink14, 0]
  - [SignalGenerator1, 0, PlotSink15, 0]
  - [SignalGenerator1, 0, PlotSink16, 0]
  - [SignalGenerator1, 0, PlotSink17, 0]
  - [SignalGenerator1, 0, PlotSink18, 0]
  - [SignalGenerator1, 0, PlotSink19, 0]
  - [SignalGenerator1, 0, PlotSink20, 0]
  - [SignalGenerator1, 0, PlotSink21, 0]
  - [SignalGenerator1, 0, PlotSink22, 0]
  - [SignalGenerator1, 0, PlotSink23, 0]
  - [SignalGenerator1, 0, PlotSink24, 0]
  - [SignalGenerator1, 0, PlotSink25, 0]
  - [SignalGenerator1, 0, PlotSink26, 0]
  - [SignalGenerator1, 0, PlotSink27, 0]
  - [SignalGenerator1, 0, PlotSink28, 0]
  - [SignalGenerator1, 0, PlotSink29, 0]
  - [SignalGenerator1, 0, PlotSink30, 0]
